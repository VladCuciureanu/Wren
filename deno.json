{
  "name": "@wren/cli",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-run src/main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --allow-run src/main.ts",
    "test": "deno test --allow-read --allow-env --allow-run --allow-write test/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/main.ts"
  },
  "imports": {
    "@std/toml": "jsr:@std/toml@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
