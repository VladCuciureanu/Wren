{
  "name": "@wren/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/mod.ts",
  "bin": {
    "wren": "./dist/main.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome check --write",
    "check": "biome check && npm run typecheck && npm test"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26",
    "typescript": "^7.0.2"
  }
}
